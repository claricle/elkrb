module Elkrb
  module Graph
    # Deprecated migration shim for 1.x call sites: a ::Hash that keeps every
    # key a String. The typed accessors it used to carry are gone — options
    # are read by id now.
    class LayoutOptions < ::Hash[String, untyped]
      def self.[]: (*untyped args) -> LayoutOptions
      def self.wrap: (untyped value) -> LayoutOptions?

      def initialize: (?Hash[String | Symbol, untyped]? hash, **untyped kw) -> void
      def []: (String | Symbol key) -> untyped
      def []=: (String | Symbol key, untyped value) -> untyped
      def store: (String | Symbol key, untyped value) -> untyped
      def merge: (Hash[String | Symbol, untyped]? other) -> self
      def merge!: (*Hash[String | Symbol, untyped] others) ?{ (String key, untyped old_value, untyped new_value) -> untyped } -> self
      def update: (*Hash[String | Symbol, untyped] others) ?{ (String key, untyped old_value, untyped new_value) -> untyped } -> self
      def replace: (Hash[String | Symbol, untyped] other) -> self
      def transform_keys!: (*untyped args) ?{ (String key) -> untyped } -> (self | Enumerator[String, self])
    end

    class Label
      attr_accessor id: String?
      attr_accessor text: String?
      attr_accessor x: Float?
      attr_accessor y: Float?
      attr_accessor width: Float?
      attr_accessor height: Float?
      attr_accessor properties: Hash[String | Symbol, untyped]?

      def self.from_hash: (Hash[String | Symbol, untyped] hash) -> Label
      def to_json: () -> String
      def to_yaml: () -> String
    end

    class Port
      attr_accessor id: String?
      attr_accessor x: Float?
      attr_accessor y: Float?
      attr_accessor width: Float?
      attr_accessor height: Float?
      attr_accessor labels: Array[Label]?

      def self.from_hash: (Hash[String | Symbol, untyped] hash) -> Port
      def to_json: () -> String
      def to_yaml: () -> String
    end

    class EdgeSection
      attr_accessor id: String?
      attr_accessor start_point: Hash[String, Float]?
      attr_accessor end_point: Hash[String, Float]?
      attr_accessor bend_points: Array[Hash[String, Float]]?
      attr_accessor incoming_shape: String?
      attr_accessor outgoing_shape: String?
      attr_accessor incoming_sections: Array[String]?
      attr_accessor outgoing_sections: Array[String]?

      def self.from_hash: (Hash[String | Symbol, untyped] hash) -> EdgeSection
      def to_json: () -> String
      def to_yaml: () -> String
    end

    class Edge
      attr_accessor id: String?
      attr_accessor sources: Array[String]?
      attr_accessor targets: Array[String]?
      attr_accessor labels: Array[Label]?
      attr_accessor sections: Array[EdgeSection]?
      def layout_options: () -> Hash[String, untyped]?
      def layout_options=: (Hash[String | Symbol, untyped]? value) -> void
      attr_accessor properties: Hash[String | Symbol, untyped]?
      attr_accessor junction_points: Array[::Elkrb::Geometry::Point]?
      attr_accessor container: String?

      def self.from_hash: (Hash[String | Symbol, untyped] hash) -> Edge
      def to_json: () -> String
      def to_yaml: () -> String
    end

    class Node
      attr_accessor id: String?
      attr_accessor x: Float?
      attr_accessor y: Float?
      attr_accessor width: Float?
      attr_accessor height: Float?
      attr_accessor labels: Array[Label]?
      attr_accessor ports: Array[Port]?
      attr_accessor children: Array[Node]?
      attr_accessor edges: Array[Edge]?
      def layout_options: () -> Hash[String, untyped]?
      def layout_options=: (Hash[String | Symbol, untyped]? value) -> void
      attr_accessor properties: Hash[String | Symbol, untyped]?

      def self.from_hash: (Hash[String | Symbol, untyped] hash) -> Node
      def to_json: () -> String
      def to_yaml: () -> String
      def hierarchical?: () -> bool
      def find_node: (String node_id) -> Node?
      def all_nodes: () -> Array[Node]
    end

    class Graph
      attr_accessor id: String?
      attr_accessor x: Float?
      attr_accessor y: Float?
      attr_accessor width: Float?
      attr_accessor height: Float?
      attr_accessor children: Array[Node]?
      attr_accessor edges: Array[Edge]?
      def layout_options: () -> Hash[String, untyped]?
      def layout_options=: (Hash[String | Symbol, untyped]? value) -> void
      attr_accessor properties: Hash[String | Symbol, untyped]?

      def self.from_hash: (Hash[String | Symbol, untyped] hash) -> Graph
      def to_json: () -> String
      def to_yaml: () -> String
      def hierarchical?: () -> bool
      def find_node: (String node_id) -> Node?
      def all_nodes: () -> Array[Node]
      def all_edges: () -> Array[Edge]
    end
  end
end
